# Argus - Environment Configuration (Example / Template)
# Copy this to /etc/argus/argus.env on the VPS, fill in secrets, and chmod 0600.
# DO NOT commit real secrets to git.
# Reference: docs/00-DESIGN.md sec  9 (Deploy topology).

# ======================================================================
# REQUIRED: Bearer token for MCP HTTP auth
# ======================================================================
# Generate a fresh 32-byte hex token via:
# openssl rand -hex 32
# Example output: a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
# Clients will pass via: Authorization: Bearer <this-token>
ARGUS_TOKEN=__GENERATE_WITH_openssl_rand_-hex_32__

# ======================================================================
# OPTIONAL: Owned LLM integration for extract_structured (LLM tier + summaries)
# ======================================================================
# If all three are unset, LLM features are disabled (no error, just skipped).
# If any one is set, all three MUST be set (provider consistency).

# API key (e.g., Groq, NVIDIA NIM, or local OpenAI-compatible server).
# Groq example: "gsk_..." (get from https://console.groq.com)
# Local OpenAI server: dummy token, e.g. "sk-local"
# ARGUS_LLM_API_KEY=gsk_...

# Base URL for the LLM service (HTTP/HTTPS endpoint).
# Groq: "https://api.groq.com/openai/v1"
# NVIDIA NIM: "https://integrate.api.nvidia.com/v1" (or self-hosted)
# Local OpenAI: "http://localhost:8000/v1" (or similar)
# ARGUS_LLM_BASE_URL=https://api.groq.com/openai/v1

# Model ID to use for inference.
# Groq examples: "mixtral-8x7b-32768", "llama-3.3-70b-versatile"
# NVIDIA: "meta/llama-3.1-405b-instruct"
# ARGUS_LLM_MODEL=mixtral-8x7b-32768

# ======================================================================
# OPTIONAL: Local filesystem PDF read (DISABLED by default on the server)
# ======================================================================
# On the development machine, set this to allow file:// URLs in read_pdf.
# On the VPS server, LEAVE UNSET (the default) to block local-path reads
# and prevent LFI attacks.
# Only comment in if you have a specific use case (trusted local network).
# ARGUS_ALLOW_LOCAL_PDF=false

# ======================================================================
# OPTIONAL: Playwright browser cache location
# ======================================================================
# By default, Playwright caches browsers under ~/.cache/ms-playwright.
# The provision.sh script ensures it's under the 'argus' user's home.
# If you need a custom path (e.g., large NVMe for performance), set it here.
# Path must be writable by the 'argus' user.
# PLAYWRIGHT_BROWSERS_PATH=/var/cache/argus-playwright

# ======================================================================
# OPTIONAL: Crawl4AI / browser behavior
# ======================================================================
# Maximum concurrent browser contexts (Semaphore size).
# Default: 4. Increase for higher throughput; each context ~ 50 MB RAM.
# ARGUS_MAX_CONCURRENT_CONTEXTS=4

# Global request timeout (seconds) for static fetches + API calls.
# ARGUS_REQUEST_TIMEOUT=30

# Browser context timeout (seconds) for rendered pages.
# ARGUS_BROWSER_TIMEOUT=60

# ======================================================================
# OPTIONAL: Search SPOF failover (secondary SearXNG instances)
# ======================================================================
# The primary search backend is the loopback SearXNG (127.0.0.1:8888). If it is
# down, search/research/smart_search/news all fail. Set a comma-separated list of
# secondary SearXNG instances (must expose ?format=json) to fail over to when the
# primary is unreachable. Results from a fallback are flagged degraded=true.
# Leave UNSET (default) for no failover. For true HA, point this at a SECOND
# self-hosted SearXNG (a public instance may rate-limit or disable the JSON API).
# Fallbacks are fetched through the SSRF-guarded client (a fallback resolving to a
# private/metadata IP is blocked). NOTE: this only helps when SearXNG is down but
# Argus is up; a full VPS/host outage needs a second Argus instance (ops HA) and a
# client-side fallback (the consuming agent uses its native web search).
# ARGUS_SEARXNG_FALLBACKS=http://10.0.0.2:8888,https://searxng-2.example.com

# ======================================================================
# LOGGING (optional, defaults to INFO to journald)
# ======================================================================
# Set to DEBUG for verbose logs (useful for troubleshooting).
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# ARGUS_LOG_LEVEL=INFO

# ======================================================================
# NOTES
# ======================================================================
# 1. This file is sourced by systemd (EnvironmentFile=/etc/argus/argus.env).
# Restart the service after changes: systemctl restart argus
# 2. Use 'systemctl status argus' to check if the service is running.
# 3. View logs: journalctl -u argus -f (follow) or -n 100 (last 100 lines)
# 4. Secrets in this file should be rotated periodically (e.g., ARGUS_TOKEN every 90 days).
# 5. If ARGUS_TOKEN is compromised, rotate immediately:
# - Generate new token (openssl rand -hex 32)
# - Update /etc/argus/argus.env
# - Restart: systemctl restart argus
# - Notify users to re-register the MCP in Claude Code with the new token
